<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Lab1.FlowWindow"
             Height="200" Width="200"
             WindowStartupLocation="CenterOwner">
        <StackPanel Spacing="10" Margin="10">
            <Button x:Name="Next" Click="Next_OnClick">Next</Button>
            <Button x:Name="Previous" Click="Previous_OnClick">Previous</Button>
            <Button x:Name="Cancel" Click="Cancel_OnClick">Cancel</Button>
            <Button x:Name="Ok" Click="Action_OnClick">Ok</Button>
        </StackPanel>
</Window>
